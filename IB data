import time
import numpy as np
import pandas as pd
from datetime import datetime, timedelta
from ibapi.client import Contract, EClient
from ibapi.wrapper import EWrapper
from ibapi.contract import Contract
from threading import Thread


class IBKRApp(EWrapper, EClient):
    def __init__(self):
        EClient.__init__(self, self)
        self.data = []
        self.finished = False

    def historicalData(self, reqId, bar):
        self.data.append({
            'datetime': bar.date,
            'open': bar.open,
            'high': bar.high,
            'low': bar.low,
            'close': bar.close,
            'volume': bar.volume
        })

    def historicalDataEnd(self, reqId, start, end):
        self.finished = True

    def error(self, reqId, *args):
        print(f"  -> IBKR message on reqId {reqId}: {args}")
        if any(isinstance(a, int) and 2100 <= a < 2200 for a in args):
            return  # informational warning, keep waiting for data
        if reqId != -1:
            self.finished = True

    def run_loop(self):
        self.run()


def get_equity_data(symbol="NVDA", sec_type="STK", total_years=20, bar_size="1 day", chunk_size="5 Y"):
    app = IBKRApp()
    app.connect('127.0.0.1', 7497, 123)
    api_thread = Thread(target=app.run_loop)
    api_thread.start()
    time.sleep(1)

    contract = Contract()
    contract.symbol = symbol
    contract.secType = sec_type
    contract.exchange = "SMART"
    contract.currency = "USD"
    if sec_type == "IND":
        contract.exchange = "CBOE"

    all_chunks = []
    current_end_date = ""
    target_start = datetime.now() - timedelta(days=total_years * 365)
    req_id = 1
    max_chunks = 30

    for _ in range(max_chunks):
        print(f"  -> Fetching chunk ending {current_end_date or 'NOW'} for {symbol}...")

        app.data = []
        app.finished = False

        app.reqHistoricalData(
            reqId=req_id,
            contract=contract,
            endDateTime=current_end_date,
            durationStr=f"{total_years} Y",
            barSizeSetting=bar_size,
            whatToShow='TRADES',
            useRTH=1,
            formatDate=1,
            keepUpToDate=False,
            chartOptions=[]
        )
        req_id += 1

        waited = 0
        while not app.finished and waited < 180:
            time.sleep(0.5)
            waited += 0.5

        if not app.data:
            print(f"  -> No more data for {symbol}, stopping.")
            break

        chunk_df = pd.DataFrame(app.data)
        all_chunks.append(chunk_df)

        earliest_str = str(chunk_df['datetime'].iloc[0]).strip()[:8]
        earliest_dt = pd.to_datetime(earliest_str, format='%Y%m%d', errors='coerce')

        if pd.isna(earliest_dt) or earliest_dt <= target_start:
            break

        current_end_date = f"{earliest_str} 16:00:00 US/Eastern"
        time.sleep(2)

    app.disconnect()

    if not all_chunks:
        print(f"Failed to fetch any data for {symbol}")
        return pd.DataFrame()

    df = pd.concat(all_chunks, ignore_index=True)
    df['datetime'] = pd.to_datetime(df['datetime'].str.slice(0, 8), format='%Y%m%d', errors='coerce')
    df = df.dropna(subset=['datetime'])
    df = df.drop_duplicates(subset=['datetime']).sort_values('datetime').reset_index(drop=True)

    df = df[df['datetime'] >= target_start]

    df['return'] = np.log(df['close'] / df['close'].shift(1))
    df = df.dropna()

    df = df[['datetime', 'open', 'high', 'low', 'close', 'volume', 'return']]
    df.to_csv(f"{symbol}_{total_years}yr_data.csv", index=False)
    print(f"Saved {symbol}_{total_years}yr_data.csv ({len(df)} rows)")
    return df


